# ------------------------------
# 1. Dependencies & Build
# ------------------------------
# Abaikan node_modules di root DAN di dalam setiap folder apps
**/node_modules

# Abaikan folder build (dist) di semua tempat
**/dist
**/build

# ------------------------------
# 2. Environment Variables (SECURITY)
# ------------------------------
# Jangan pernah masukkan .env ke dalam image!
# Gunakan docker-compose environment variables sebagai gantinya.
**/.env
**/.env.*
# Kecuali file example (aman untuk dokumentasi)
!**/.env.example

# ------------------------------
# 3. Git & IDE Files
# ------------------------------
.git
.gitignore
.vscode
.idea
*.swp
*.swo

# ------------------------------
# 4. Logs & Debugging
# ------------------------------
npm-debug.log
yarn-debug.log
yarn-error.log
**/*.log

# ------------------------------
# 5. Testing & Coverage
# ------------------------------
# Tidak perlu memasukkan file test coverage ke production image
**/coverage
**/test
**/tests

# ------------------------------
# 6. Docker & Infrastructure
# ------------------------------
# File-file ini dipakai di host, tidak perlu dicopy ke dalam container
docker-compose.yml
docker-compose.*.yml
.dockerignore
Dockerfile
**/Dockerfile

# Folder infra (init.sql) tidak perlu masuk ke image aplikasi Node.js
infra/