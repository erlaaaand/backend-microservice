{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/notification/infrastructure/channels/email/templates/**/*",
        "outDir": "dist/modules/notification/infrastructure/channels/email/templates",
        "watchAssets": true
      }
    ]
  }
}