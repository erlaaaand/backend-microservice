# =============================================================================
# APPLICATION SETUP
# =============================================================================
PORT=3002
NODE_ENV=development
SERVICE_NAME=notification-service

# =============================================================================
# DATABASE (MySQL)
# Digunakan untuk menyimpan log history notifikasi (siapa dikirim apa, kapan)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=notification_db

# =============================================================================
# REDIS (Cache & Queue Engine)
# Sangat krusial untuk Notification Service karena digunakan oleh BullMQ
# untuk antrean reminder dan delay job.
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# RABBITMQ (Message Broker)
# Digunakan untuk menerima trigger event dari Auth Service (user.created, dll)
# =============================================================================
# URL harus sama persis dengan yang ada di Auth Service
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Nama Queue yang spesifik untuk service ini mendengarkan pesan
RABBITMQ_QUEUE=notification_queue

# =============================================================================
# SMTP CONFIGURATION (Email Sender)
# Ini adalah "Nyawa" dari service ini.
# Untuk local dev, SANGAT DISARANKAN menggunakan Mailtrap.io (gratis)
# agar tidak mengirim email sungguhan ke user saat testing.
# =============================================================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user_id
SMTP_PASS=your_mailtrap_password
# Format: "Nama Pengirim <email@domain.com>"
SMTP_FROM="My App System <noreply@myapp.com>"

# =============================================================================
# RATE LIMITING & THROTTLING
# Mencegah service ini di-banned oleh SMTP provider karena spamming
# =============================================================================
# Maksimal request per menit
THROTTLE_TTL=60000
THROTTLE_LIMIT=50

# =============================================================================
# FUTURE CHANNELS (Placeholder)
# Siapkan slot untuk masa depan (WA/SMS) agar tidak lupa
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=