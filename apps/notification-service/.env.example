# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
PORT=3002
NODE_ENV=development
SERVICE_NAME=notification-service
API_PREFIX=api/v1

# Security
API_KEY=your-super-secret-api-key-change-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug # debug, info, warn, error

# Timeouts (in milliseconds)
DEFAULT_TIMEOUT=30000
REQUEST_TIMEOUT=30000

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# DATABASE (MySQL)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=notification_db
DATABASE_CONNECTION_LIMIT=10

# =============================================================================
# REDIS (Cache & Queue Engine)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_KEY_PREFIX=notification:

# =============================================================================
# RABBITMQ (Message Broker)
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=notification_queue
RABBITMQ_PREFETCH=10

# =============================================================================
# EMAIL PROVIDER CONFIGURATION
# Choose: smtp, sendgrid, ses
# =============================================================================
EMAIL_PROVIDER=smtp

# --- SMTP Configuration (Recommended: Mailtrap for testing) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user_id
SMTP_PASS=your_mailtrap_password
SMTP_FROM="My App System <noreply@myapp.com>"

# --- SendGrid Configuration (Optional) ---
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM=noreply@myapp.com

# --- AWS SES Configuration (Optional) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# SES_FROM=noreply@myapp.com

# Common Email Settings
EMAIL_REPLY_TO=support@myapp.com

# =============================================================================
# RATE LIMITING & THROTTLING
# =============================================================================
# Global rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Throttling (prevent spamming)
THROTTLE_TTL=60000
THROTTLE_LIMIT=50

# Per-email rate limiting
EMAIL_RATE_LIMIT_PER_HOUR=10
EMAIL_RATE_LIMIT_PER_DAY=50

# Batch processing
BATCH_MAX_SIZE=100
BATCH_RATE_LIMIT_PER_MINUTE=500

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
# Job retry settings
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_DELAY=2000
QUEUE_BACKOFF_TYPE=exponential

# Queue processing
QUEUE_CONCURRENCY=5
QUEUE_LOCK_DURATION=30000

# =============================================================================
# RETRY STRATEGY
# =============================================================================
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=60000
RETRY_BACKOFF_MULTIPLIER=2

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# =============================================================================
# MONITORING & METRICS
# =============================================================================
# Prometheus metrics
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Health check intervals (in seconds)
HEALTH_CHECK_INTERVAL=30

# Alert thresholds
ALERT_FAILED_JOBS_THRESHOLD=100
ALERT_QUEUE_BACKLOG_THRESHOLD=1000
ALERT_STALLED_JOB_THRESHOLD=600000

# =============================================================================
# APPLICATION URLS
# =============================================================================
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3002

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_EMAIL=true
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_PUSH=false

ENABLE_BATCH_PROCESSING=true
ENABLE_SCHEDULED_REMINDERS=true
ENABLE_RETRY_MECHANISM=true

# =============================================================================
# EXTERNAL SERVICES (Future integrations)
# =============================================================================
# Twilio (for SMS/WhatsApp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=

# Firebase (for Push notifications)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Slack (for alerts)
# SLACK_WEBHOOK_URL=
# SLACK_CHANNEL=#alerts

# PagerDuty (for critical alerts)
# PAGERDUTY_API_KEY=
# PAGERDUTY_SERVICE_KEY=

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Enable debug mode
DEBUG=false

# Mock services (for testing)
MOCK_EMAIL_PROVIDER=false
MOCK_SMS_PROVIDER=false

# Database seeding
AUTO_SEED_TEMPLATES=true

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================
# Data retention (in days)
LOG_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=365

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-min

# GDPR Compliance
ENABLE_GDPR_MODE=false
ALLOW_DATA_EXPORT=true
ALLOW_DATA_DELETION=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Cache TTL (in seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
CACHE_TTL_VERY_LONG=86400

# Database connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Worker threads
WORKER_THREADS=4

# =============================================================================
# NOTES
# =============================================================================
# 1. For production, use strong API_KEY and ENCRYPTION_KEY
# 2. Never commit .env file to git
# 3. Use Mailtrap.io for testing emails (free tier available)
# 4. Enable only the channels you need (EMAIL, SMS, WhatsApp)
# 5. Adjust rate limits based on your SMTP provider's limits
# 6. Monitor queue sizes and adjust concurrency accordingly
# 7. Set appropriate log retention for compliance requirements